# ─────────────────────────────────────────────────────────────
#  Bybit Futures Bot  |  Environment Variables Template
#  1. Copy:  cp .env.example .env
#  2. Fill in ALL values marked *** SECRET ***
#  3. NEVER commit .env to git (it is in .gitignore)
#  4. See SECURITY.md for secret management guide
# ─────────────────────────────────────────────────────────────

# ── Trading Mode ─────────────────────────────────────────────
# Options: dry-run | paper | live
# LIVE is locked unless QUALITY_GATE_PASSED=true
TRADING_MODE=dry-run

# ── Bybit API  *** SECRET ***  ─────────────────────────────────
# Get from: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# true = Testnet (safe), false = Mainnet (real money)
BYBIT_TESTNET=true
BYBIT_RECV_WINDOW=5000
# true = Hedge Mode (hold long+short simultaneously), false = One-Way Mode
BYBIT_HEDGE_MODE=true

# ── Capital & Risk ────────────────────────────────────────────
# Starting paper capital (USDT)
PAPER_CAPITAL_USDT=10000.0
# Max risk per trade as fraction of equity (0.01 = 1%)
MAX_RISK_PER_TRADE_PCT=0.01
# Daily loss limit (stop trading today if exceeded)
MAX_DAILY_LOSS_PCT=0.05
# Weekly loss limit
MAX_WEEKLY_LOSS_PCT=0.10
# Max drawdown before halting bot
MAX_DRAWDOWN_PCT=0.20
# Risk engine leverage cap (separate from exchange max)
MAX_LEVERAGE_CAP=20
# Max concurrent open positions
MAX_CONCURRENT_POSITIONS=3
# Max total exposure as % of equity
MAX_TOTAL_EXPOSURE_PCT=0.60
# Max single symbol exposure as % of equity
MAX_SINGLE_EXPOSURE_PCT=0.25

# ── Signal Settings ───────────────────────────────────────────
# Signal strength threshold to enter (0.0-1.0)
SIGNAL_ENTRY_THRESHOLD=0.55
SIGNAL_EXIT_THRESHOLD=0.40
# Main signal timeframe (5-min scalp default)
SIGNAL_TIMEFRAME=5
# Higher timeframe for regime detection
TREND_TIMEFRAME=60
# How often to refresh top-N universe (hours)
UNIVERSE_REFRESH_INTERVAL_HOURS=4
# How many top coins to trade
TOP_N_COINS=5

# ── Scalping Parameters ───────────────────────────────────────
# VWAP rolling window (96 bars = 8h at 5-min)
VWAP_SESSION_BARS=96
# SCALP mode (fast exits, 5-min duration typical)
SCALP_STOP_ATR=0.8
SCALP_TP1_ATR=1.0
SCALP_TP2_ATR=1.8
SCALP_MAX_BARS=15
SCALP_PARTIAL_EXIT_PCT=0.60
# TREND_RIDE mode (wider stops, ride momentum)
TREND_STOP_ATR=1.5
TREND_TP1_ATR=2.0
TREND_TP2_ATR=4.0
TREND_MAX_BARS=120
TREND_PARTIAL_EXIT_PCT=0.50
# Min score to switch from SCALP to TREND_RIDE
TREND_RIDE_SCORE_THRESHOLD=3

# ── Signal Quality Filters (Kaufman / Peters) ─────────────────
# Efficiency Ratio minimum — reject choppy markets
# Range 0-1; 0.35 = only take trades in moderately trending conditions
SIGNAL_FILTER_ER_THRESHOLD=0.15
# Hurst exponent minimum — reject mean-reverting conditions for momentum
# Range 0-1; 0.45 = avoid pure random walk and mean-reverting
SIGNAL_FILTER_HURST_MIN=0.45
# Minimum ATR as % of price — reject dead/illiquid markets
SIGNAL_FILTER_MIN_ATR_PCT=0.0004

# ── Advanced Risk Management ──────────────────────────────────
# AQR volatility targeting: annualized vol target (0.15 = 15%/year)
VOLATILITY_TARGET_PCT=0.15
# Quarter-Kelly fraction (Van K. Tharp approach: 0.25 = very conservative)
USE_KELLY_FRACTION=0.25

# ── Indicators ────────────────────────────────────────────────
ATR_PERIOD=14
STOP_ATR_MULTIPLIER=2.0
TP_ATR_MULTIPLIER=3.0
TRAILING_STOP_ATR_MULTIPLIER=1.5
ADX_PERIOD=14
ADX_TREND_THRESHOLD=25.0
ADX_RANGE_THRESHOLD=20.0
EMA_FAST=9
EMA_MID=21
EMA_SLOW=50
VOLATILITY_LOOKBACK=20
RSI_PERIOD=14
BB_PERIOD=20
BB_STD=2.0
# Keltner channel (Chester Keltner / Linda Raschke)
KELTNER_PERIOD=20
KELTNER_ATR_MULT=1.5
# Hull Moving Average (Alan Hull, 2005)
HULL_MA_PERIOD=16

# ── ICT Settings ─────────────────────────────────────────────
ICT_SWING_PERIOD=5
ICT_FVG_LOOKBACK=50
ICT_RANGE_PERIOD=20

# ── Order Execution ───────────────────────────────────────────
LIMIT_ORDER_TIMEOUT_SECONDS=30
LIMIT_ORDER_MAX_RETRIES=3
REENTRY_COOLDOWN_SECONDS=300
# Switch to market order if spread exceeds this
SPREAD_TAKER_THRESHOLD=0.003

# ── Profit Protection ────────────────────────────────────────
# Automatically transfer profits to Funding Account for safety
PROFIT_PROTECT_ENABLED=true
# Trigger when profit exceeds this % of initial capital (0.20 = 20%)
PROFIT_PROTECT_THRESHOLD_PCT=0.20
# What fraction of profits to move to Funding Account (0.50 = 50%)
PROFIT_PROTECT_TRANSFER_PCT=0.50
# Always keep at least this multiple of initial capital in trading account
PROFIT_PROTECT_MIN_CAPITAL_PCT=1.10
# How often to check (hours)
PROFIT_PROTECT_CHECK_HOURS=24

# ── Slack Notifications  *** SECRET ***  ─────────────────────
# Get from: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Daily briefing hour (24h, Asia/Seoul timezone)
SLACK_DAILY_REPORT_HOUR=9

# ── Backtest Settings ─────────────────────────────────────────
BACKTEST_START=
BACKTEST_END=
BACKTEST_FEE_TAKER=0.00055
BACKTEST_FEE_MAKER=0.00020
BACKTEST_SLIPPAGE_PCT=0.0002
BACKTEST_INITIAL_CAPITAL=10000.0
# Average funding rate for backtest simulation
BACKTEST_FUNDING_RATE_AVG=0.0001

# ── Quality Gate ─────────────────────────────────────────────
QUALITY_GATE_SHARPE=1.0
QUALITY_GATE_MDD=0.30
QUALITY_GATE_WIN_RATE=0.45
QUALITY_GATE_PROFIT_FACTOR=1.5
QUALITY_GATE_MIN_TRADES=100
# !! Set to true ONLY after backtest PASSES quality gate !!
QUALITY_GATE_PASSED=false

# ── Database ──────────────────────────────────────────────────
DATABASE_PATH=bot.db

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
